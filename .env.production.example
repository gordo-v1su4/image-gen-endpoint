# Production Environment Variables for RTX 4090 Deployment
# Copy this to .env or set in Coolify environment

# Core application settings
PORT=8000
HOST=0.0.0.0

# GPU configuration
CUDA_VISIBLE_DEVICES=0

# GGUF model paths (matches Dockerfile paths)
SD_CLI_PATH=/opt/stable-diffusion.cpp/build/bin/sd-cli
GGUF_MODELS_PATH=/opt/models/qwen-gguf

# Model manager settings
MODELS_PATH=/opt/models
DEFAULT_MODEL=qwen-2512-gguf

# Optional: HuggingFace token (NOT needed for current models, all public)
# Only uncomment if you later add private model repos
# HF_TOKEN=hf_your_token_here
