# GGUF Configuration for Qwen-Image-2512
# Copy this to your .env file or set in Coolify

# stable-diffusion.cpp binary path
SD_CLI_PATH=/opt/sd-cpp/build/bin/sd-cli

# GGUF models directory
GGUF_MODELS_PATH=/opt/models/qwen-gguf

# Model files
GGUF_MODEL_FILE=qwen-image-2512-Q4_K_M.gguf
GGUF_TEXT_ENCODER=Qwen2.5-VL-7B-Instruct-UD-Q4_K_XL.gguf
GGUF_VAE=qwen_image_vae.safetensors

# Generation settings
DEFAULT_STEPS=40
DEFAULT_CFG_SCALE=2.5
DEFAULT_SAMPLING_METHOD=euler

# Image dimensions (Qwen native resolution for 1:1)
DEFAULT_WIDTH=1328
DEFAULT_HEIGHT=1328

# CUDA settings
CUDA_VISIBLE_DEVICES=0
