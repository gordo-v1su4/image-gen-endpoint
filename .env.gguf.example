# GGUF Configuration for Qwen-Image-2512
# Copy this to your .env file or set in Coolify
# Reference: https://unsloth.ai/docs/models/qwen-image-2512/stable-diffusion.cpp

# stable-diffusion.cpp binary path
SD_CLI_PATH=/opt/stable-diffusion.cpp/build/bin/sd-cli

# GGUF models directory
GGUF_MODELS_PATH=/opt/models/qwen-gguf

# Model files (downloaded automatically on first start)
# - qwen-image-2512-Q4_K_M.gguf (~13GB) - Text-to-image generation
# - qwen-image-edit-2511-Q4_K_M.gguf (~13GB) - Image editing
# - Qwen2.5-VL-7B-Instruct-UD-Q4_K_XL.gguf (~4.5GB) - Text encoder
# - qwen_image_vae.safetensors (~243MB) - VAE

# Generation settings (per Unsloth recommendations)
DEFAULT_STEPS=40
DEFAULT_CFG_SCALE=2.5
DEFAULT_SAMPLING_METHOD=euler
DEFAULT_MODEL=qwen-2512-gguf

# Image dimensions (supported by Qwen)
DEFAULT_WIDTH=1328
DEFAULT_HEIGHT=1328

# CUDA settings
CUDA_VISIBLE_DEVICES=0

# Optional: Enable CPU offload for systems with limited VRAM (<20GB)
# Set to true if you have less than 20GB VRAM
OFFLOAD_TO_CPU=false

# Optional: Enable verbose output for debugging
SD_VERBOSE=false

# Server settings
HOST=0.0.0.0
PORT=8000