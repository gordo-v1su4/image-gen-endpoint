# Image Generation API - Environment Configuration

# HuggingFace cache directory for diffusers models
HF_HOME=/opt/models/huggingface

# Optional: HuggingFace token for gated models
# HF_TOKEN=hf_your_token_here

# CUDA settings
CUDA_VISIBLE_DEVICES=0

# Default model (qwen-2512-lightning or flux-klein-4b)
DEFAULT_MODEL=qwen-2512-lightning
