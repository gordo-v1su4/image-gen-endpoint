# Image Generation API - Environment Configuration

# HuggingFace cache directory for diffusers models
HF_HOME=/opt/models/huggingface

# Optional: HuggingFace token for gated models
# HF_TOKEN=hf_your_token_here
HF_TOKEN=${HF_TOKEN}
# CUDA settings
CUDA_VISIBLE_DEVICES=0

# Default model (flux-klein-4b is recommended, qwen-2512-fp8-4step requires special framework)
DEFAULT_MODEL=flux-klein-4b
